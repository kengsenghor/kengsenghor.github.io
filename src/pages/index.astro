---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import CaseCard from '../components/CaseCard.astro';
import { roles, profile, certifications, skills, type Stage as StageName } from '../data/career';

// Optional photo: lives in a git-ignored file locally and is supplied to CI from a private secret.
const photos = import.meta.glob('../assets/headshot.jpg', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const photo = Object.values(photos)[0];

let cases: { id: string; data: { title: string; summary: string; tags: string[] } }[] = [];
try {
  const { getCollection } = await import('astro:content');
  cases = (await getCollection('work')) as typeof cases;
} catch {
  cases = [];
}

const order: StageName[] = ['firmware', 'telecom', 'qa-leadership', 'engineering-management'];
const year = (d: string) => d.slice(0, 4);
const logLines = order.map((s) => {
  const rs = roles.filter((r) => r.stage === s);
  const from = Math.min(...rs.map((r) => Number(year(r.start))));
  const to = rs.some((r) => r.end === 'present') ? 'present' : String(Math.max(...rs.map((r) => Number(year(r.end)))));
  return { stage: s, text: `stage ${s} (${from} to ${to}): passed` };
});
---
<Base title="Keng Seng Hor | Work portfolio" description="Work portfolio of Keng Seng Hor, Senior Software Engineering Manager: quality engineering, delivery and AI-assisted engineering.">
  <section class="hero">
    {photo
      ? <img class="headshot" src={photo} width="120" height="120" alt="Portrait of Keng Seng Hor" />
      : <div class="monogram" aria-hidden="true">KH</div>}
    <div>
      <h1>Keng Seng Hor</h1>
      <p class="title">{profile.title}</p>
      <p>{profile.summary}</p>
      <p class="links">
        <a href={profile.linkedin}>LinkedIn</a> · <a href={`mailto:${profile.email}`}>Email</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="run">
    <h2 id="run">Pipeline run</h2>
    <p class="row" id="run-actions" hidden>
      <button type="button" class="btn" id="run-pipeline">Run pipeline</button>
      <button type="button" class="btn" id="reset-pipeline" hidden>Reset</button>
      <span id="run-status" role="status" class="muted"></span>
    </p>
    <ol class="build-log" id="build-log">
      <li class="cmd" data-cmd>$ pipeline run --career</li>
      {logLines.map((l) => <li data-stage={l.stage}><span class="ok">✔</span> <a class="stage-link" href="#stages" data-stage={l.stage}>{l.text}</a></li>)}
      <li data-gate><span class="ok">✔</span> quality gate: passed</li>
    </ol>
  </section>

  <section aria-labelledby="stages">
    <h2 id="stages">Stages</h2>
    <p class="row" id="stage-actions" hidden>
      <button type="button" class="btn" id="expand-all">Expand all</button>
      <button type="button" class="btn" id="collapse-all">Collapse all</button>
    </p>
    {roles.map((r) => <Stage role={r} />)}
  </section>

  <section aria-labelledby="work">
    <h2 id="work">Selected work</h2>
    <div class="grid">
      {cases.map((c) => <CaseCard slug={c.id} title={c.data.title} summary={c.data.summary} tags={c.data.tags} />)}
    </div>
    <p><a href="/work">All case studies</a></p>
  </section>

  <section aria-labelledby="skills">
    <h2 id="skills">Skills and certifications</h2>
    <ul class="chips">{skills.map((s) => <li>{s}</li>)}</ul>
    <ul>{certifications.map((c) => <li>{c}</li>)}</ul>
  </section>
</Base>

<script>
  const actions = document.getElementById('stage-actions')!;
  const stages = () => [...document.querySelectorAll<HTMLDetailsElement>('details.stage')];
  document.getElementById('expand-all')!.addEventListener('click', () => stages().forEach((d) => (d.open = true)));
  document.getElementById('collapse-all')!.addEventListener('click', () => stages().forEach((d) => (d.open = false)));
  actions.hidden = false;

  // Run pipeline: play the build log line by line.
  const log = document.getElementById('build-log')!;
  const lines = [...log.querySelectorAll<HTMLElement>('li')];
  const runBtn = document.getElementById('run-pipeline') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-pipeline') as HTMLButtonElement;
  const status = document.getElementById('run-status')!;
  let token = 0;

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  function showAll() {
    token++;
    lines.forEach((l) => l.removeAttribute('data-pending'));
    resetBtn.hidden = true;
    runBtn.hidden = false;
    status.textContent = '';
  }
  async function run() {
    const mine = ++token;
    resetBtn.hidden = false;
    if (reduced()) {
      lines.forEach((l) => l.removeAttribute('data-pending'));
      status.textContent = 'Pipeline run complete';
      return;
    }
    lines.forEach((l, i) => (i === 0 ? l.removeAttribute('data-pending') : l.setAttribute('data-pending', '')));
    status.textContent = 'Running pipeline';
    for (let i = 1; i < lines.length; i++) {
      await wait(450);
      if (mine !== token) return;
      lines[i].removeAttribute('data-pending');
    }
    status.textContent = 'Pipeline run complete';
  }
  runBtn.addEventListener('click', run);
  resetBtn.addEventListener('click', showAll);
  document.getElementById('run-actions')!.hidden = false;

  // Clicking a stage line opens that stage and moves focus to it.
  log.querySelectorAll<HTMLAnchorElement>('a.stage-link').forEach((a) =>
    a.addEventListener('click', (e) => {
      const target = document.querySelector<HTMLDetailsElement>(`details.stage[data-stage="${a.dataset.stage}"]`);
      if (!target) return;
      e.preventDefault();
      target.open = true;
      const summary = target.querySelector('summary')!;
      summary.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'center' });
      summary.focus({ preventScroll: true });
    }),
  );
</script>

<style>
  .hero { display: grid; gap: 1.25rem; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 40rem) { .hero { grid-template-columns: auto 1fr; } }
  .headshot { border-radius: 50%; width: 120px; height: 120px; object-fit: cover; border: 2px solid var(--line); }
  .monogram { display: grid; place-items: center; width: 120px; height: 120px; border-radius: 50%; border: 2px solid var(--line); background: var(--surface); color: var(--accent); font: 700 2.2rem/1 var(--mono); letter-spacing: .05em; }
  .title { font-family: var(--mono); color: var(--muted); margin: 0 0 1rem; }
  .build-log { font-family: var(--mono); font-size: .9rem; list-style: none; margin: 0; padding: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow-wrap: anywhere; }
  .build-log li { margin: .15rem 0; }
  .build-log .cmd { color: var(--muted); }
  .build-log li[data-pending] { visibility: hidden; }
  .build-log a { color: inherit; text-decoration: none; }
  .build-log a:hover { text-decoration: underline; }
  .ok { color: var(--ok); }
  .row { display: flex; gap: .5rem; margin: 0 0 1rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; font-size: .9rem; }
  .chips li { border: 1px solid var(--line); border-radius: 999px; padding: .1rem .75rem; background: var(--surface); }
</style>
