---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCollection } from 'astro:content';
const cases = await getCollection('work');
---
<Base title="Work | Keng Seng Hor" description="Case studies of engineering, quality and AI-assisted delivery work.">
  <h1>Work</h1>
  <p class="muted">Case studies, described without company or product names.</p>
  <div class="grid">
    {cases.map((c) => <CaseCard slug={c.id} title={c.data.title} summary={c.data.summary} tags={c.data.tags} />)}
  </div>
</Base>
<style>
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
</style>
