---
interface Props { slug: string; title: string; summary: string; tags: string[] }
const { slug, title, summary, tags } = Astro.props;
---
<article class="card" data-entry={JSON.stringify({ title, summary, tags })}>
  <h3><a href={`/work/${slug}`}>{title}</a></h3>
  <p>{summary}</p>
  <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
</article>
<style>
  .card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1rem 1.25rem; }
  .card h3 { margin: 0 0 .5rem; }
  .card p { margin: 0 0 .75rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 0; font-family: var(--mono); font-size: .8rem; color: var(--muted); }
  .tags li { border: 1px solid var(--line); border-radius: 999px; padding: 0 .6rem; }
</style>
