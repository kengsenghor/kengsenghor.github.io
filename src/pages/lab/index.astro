---
import Base from '../../layouts/Base.astro';
---
<Base title="Lab | Keng Seng Hor" description="Small interactive pieces drawn from my work: a game about governing AI agents and a sprint forecast calculator.">
  <h1>Lab</h1>
  <p class="muted">Small interactive pieces drawn from the work. Nothing leaves your browser.</p>
  <div class="grid">
    <article class="card">
      <h3><a href="/lab/ship-or-halt">Ship or halt</a></h3>
      <p>An AI agent proposes a fix to a failing test. Do you allow it, or halt? Seven short scenarios, two of them legitimate fixes.</p>
    </article>
    <article class="card">
      <h3><a href="/work/forecasting-with-points-per-person-day#forecast-calc">Sprint forecast calculator</a></h3>
      <p>Enter recent sprints and the coming one to see velocity per person-day, capacity and any stretch.</p>
    </article>
  </div>
</Base>
<style>
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-top: 1.5rem; }
  .card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1rem 1.25rem; }
  .card h3 { margin: 0 0 .5rem; }
  .card p { margin: 0; }
</style>
